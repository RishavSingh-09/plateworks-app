{
  "kind": "collectionType",
  "collectionName": "gym_classes",
  "info": {
    "singularName": "gym-class",
    "pluralName": "gym-classes",
    "displayName": "Gym class",
    "description": "Weekly timetable. intensity 1-5 maps to plates 5/10/15/20/25 kg."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "day": {
      "type": "enumeration",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "required": true
    },
    "startTime": {
      "type": "time",
      "required": true
    },
    "durationMin": {
      "type": "integer",
      "required": true,
      "min": 10,
      "max": 180
    },
    "intensity": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    "capacity": {
      "type": "integer",
      "min": 1
    },
    "trainer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::trainer.trainer",
      "inversedBy": "classes"
    }
  }
}
